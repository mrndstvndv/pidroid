<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: pi-bridge serves plain ws:// on the LAN (no TLS yet).
  Android blocks cleartext from API 28+ unless explicitly allowed, so debug
  builds permit it. The release manifest intentionally has no
  networkSecurityConfig: release builds will reject cleartext until the bridge
  supports wss:// (see TODO.md, bridge auth item).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
